; ciscoterm topology file
; Lab: 3-router / 2-switch topology
; Edit device console= fields to match your USB adapter paths

; ─────────────────────────────────────────────────────
;  Devices
; ─────────────────────────────────────────────────────

[device R1]
hostname = R1-Core
type     = router
console  = /dev/ttyUSB0
config   = configs/R1.cfg
ui_row   = 2
ui_col   = 4

[device R2]
hostname = R2-Branch
type     = router
console  = /dev/ttyUSB1
config   = configs/R2.cfg
ui_row   = 2
ui_col   = 30

[device R3]
hostname = R3-Edge
type     = router
console  = /dev/ttyUSB2
config   = configs/R3.cfg
ui_row   = 8
ui_col   = 17

[device SW1]
hostname = SW1-Access
type     = switch
console  = /dev/ttyUSB3
config   = configs/SW1.cfg
ui_row   = 14
ui_col   = 4

[device SW2]
hostname = SW2-Access
type     = switch
console  = /dev/ttyUSB4
config   = configs/SW2.cfg
ui_row   = 14
ui_col   = 30

; ─────────────────────────────────────────────────────
;  Interfaces
; ─────────────────────────────────────────────────────

[interface R1 Fa0/0]
ip = 10.0.12.1/30

[interface R1 Fa0/1]
ip = 10.0.13.1/30

[interface R1 Lo0]
ip = 1.1.1.1/32

[interface R2 Fa0/0]
ip = 10.0.12.2/30

[interface R2 Fa0/1]
ip = 10.0.23.1/30

[interface R2 Lo0]
ip = 2.2.2.2/32

[interface R3 Fa0/0]
ip = 10.0.13.2/30

[interface R3 Fa0/1]
ip = 10.0.23.2/30

[interface R3 Lo0]
ip = 3.3.3.3/32

[interface SW1 Vlan1]
ip = 192.168.10.254/24

[interface SW2 Vlan1]
ip = 192.168.20.254/24

; ─────────────────────────────────────────────────────
;  Links
; ─────────────────────────────────────────────────────

[link]
from    = R1:Fa0/0
to      = R2:Fa0/0
network = 10.0.12.0/30

[link]
from    = R1:Fa0/1
to      = R3:Fa0/0
network = 10.0.13.0/30

[link]
from    = R2:Fa0/1
to      = R3:Fa0/1
network = 10.0.23.0/30

[link]
from    = R1:Fa1/0
to      = SW1:Gi0/1
network = 192.168.10.0/24

[link]
from    = R2:Fa1/0
to      = SW2:Gi0/1
network = 192.168.20.0/24
